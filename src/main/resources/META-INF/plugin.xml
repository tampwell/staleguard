<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.tampwell.staleguard</id>
    <name>Staleguard</name>
    <vendor>Tampwell</vendor>
    <description><![CDATA[
        <p>Staleguard shows outdated Maven and Gradle dependencies right in the editor: severity-labeled warnings, one-click version bumps, and abandonment alerts for libraries that stopped shipping releases.</p>
        <ul>
            <li><b>Inline upgrade hints</b> with major/minor/patch severity and release-age context</li>
            <li><b>One-click fixes</b> that correctly edit Maven properties and Gradle version catalogs — never inline literals over references</li>
            <li><b>Abandonment detection</b>: flags dependencies whose newest release is years old, with the actual date</li>
            <li><b>Batch updates</b> with a severity-grouped preview, plus one-click "apply all patch"</li>
            <li><b>Statistics and timeline</b> tool window with license visibility and PNG export</li>
            <li><b>Changelog links</b> straight to the project's releases page</li>
        </ul>
        <p>Supports pom.xml, build.gradle, build.gradle.kts, and libs.versions.toml. Stable-only suggestions by default. No telemetry, no accounts — data comes directly from Maven Central with a polite 24-hour cache.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="staleguard-withGroovy.xml">org.intellij.groovy</depends>
    <depends optional="true" config-file="staleguard-withKotlin.xml">org.jetbrains.kotlin</depends>

    <resource-bundle>messages.StaleguardBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Staleguard" displayType="BALLOON"/>
        <toolWindow id="Staleguard"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowHierarchy"
                    factoryClass="com.tampwell.staleguard.toolwindow.StaleguardToolWindowFactory"/>
        <localInspection language="XML"
                         bundle="messages.StaleguardBundle"
                         key="inspection.freshness.display.name"
                         groupKey="inspection.group"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.tampwell.staleguard.inspection.DependencyFreshnessInspection"/>
        <applicationConfigurable parentId="tools"
                                 id="com.tampwell.staleguard.settings"
                                 instance="com.tampwell.staleguard.settings.StaleguardConfigurable"
                                 bundle="messages.StaleguardBundle"
                                 key="settings.display.name"/>
    </extensions>

    <actions>
        <action id="com.tampwell.staleguard.ListDeclaredDependencies"
                class="com.tampwell.staleguard.actions.ListDeclaredDependenciesAction"
                text="Staleguard: List Declared Dependencies"
                description="Log every dependency declared in the project's Maven pom files">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.tampwell.staleguard.BatchUpdate"
                class="com.tampwell.staleguard.actions.BatchUpdateAction"
                text="Staleguard: Update Dependencies…"
                description="Preview and apply available dependency upgrades across all Maven modules">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.tampwell.staleguard.ApplyAllPatch"
                class="com.tampwell.staleguard.actions.ApplyAllPatchAction"
                text="Staleguard: Apply All Patch Updates"
                description="Apply every available patch-level dependency upgrade without a dialog">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
