<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.tampwell.staleguard</id>
    <name>Staleguard</name>
    <vendor>Tampwell</vendor>
    <description><![CDATA[
        <p>Keeps Maven and Gradle dependencies fresh: inline upgrade hints, one-click version bumps, and warnings for abandoned libraries.</p>
        <p>(Placeholder description — final marketplace copy to be written by the author before publishing.)</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <resource-bundle>messages.StaleguardBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Staleguard" displayType="BALLOON"/>
        <localInspection language="XML"
                         bundle="messages.StaleguardBundle"
                         key="inspection.freshness.display.name"
                         groupKey="inspection.group"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.tampwell.staleguard.inspection.DependencyFreshnessInspection"/>
    </extensions>

    <actions>
        <action id="com.tampwell.staleguard.ListDeclaredDependencies"
                class="com.tampwell.staleguard.actions.ListDeclaredDependenciesAction"
                text="Staleguard: List Declared Dependencies"
                description="Log every dependency declared in the project's Maven pom files">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
